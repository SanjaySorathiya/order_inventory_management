# FastAPI / uv project
# Commit pyproject.toml, uv.lock, .python-version, and safe .env examples.
# Keep source, tests, exercises, migrations, Docker configuration, and docs
# (including interview revision PDFs) available to commit.

# Python environments
.venv*/
venv/
env/
ENV/
__pypackages__/

# Local settings and secrets
.env
.env.*
.envrc
!.env.example
!.env.*.example
/secrets/
.pypirc

# Python bytecode and compiled extensions
__pycache__/
*.py[cod]
*$py.class
*.so

# Python packaging output
/build/
/dist/
/wheels/
.eggs/
*.egg-info/
*.egg

# Tests, coverage, lint, and type-checker caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.pyre/
.pytype/
.hypothesis/
.tox/
.nox/
.cache/
.coverage
.coverage.*
/coverage.xml
/htmlcov/
/coverage/
/test-results/
/junit*.xml
.dmypy.json
dmypy.json

# Runtime logs and temporary files
*.log
*.log.*
*.pid
/tmp/
/temp/
/logs/
tempCodeRunnerFile.py

# Local database files and sidecars (root only; keep test fixtures trackable)
/*.db
/*.db-*
/*.sqlite
/*.sqlite-*
/*.sqlite3
/*.sqlite3-*

# Local PostgreSQL volumes, backups, and uploaded runtime files
/pgdata/
/postgres-data/
/docker/volumes/
/backups/
/uploads/

# Generated documentation output (keep authored Markdown and PDFs)
/docs/_build/
/site/
.ipynb_checkpoints/

# IDE state; keep the current portable VS Code project configuration
.idea/
*.iml
*.code-workspace
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/tasks.json
!.vscode/*.code-snippets

# Operating-system and editor clutter
.DS_Store
._*
Thumbs.db
Desktop.ini
*.swp
*.swo
*~
